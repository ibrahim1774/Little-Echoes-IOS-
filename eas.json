{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "node": "22.17.0"
    },
    "preview": {
      "distribution": "internal",
      "node": "22.17.0",
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "node": "22.17.0",
      "channel": "production",
      "resourceClass": "medium"
    },
    "adhoc": {
      "extends": "production",
      "distribution": "internal",
      "autoIncrement": false,
      "credentialsSource": "local"
    },
    "release-simulator": {
      "extends": "production",
      "autoIncrement": false,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6819103746"
      }
    }
  }
}
